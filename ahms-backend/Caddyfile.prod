# ==========================================================================
# AHMS Caddy reverse-proxy (production)
# Replace app.ahms-hospital.com with your real domain(s).
# Caddy obtains and renews TLS certificates automatically via Let's Encrypt.
# The frontend nginx container serves the SPA and proxies /api to backend.
# ==========================================================================

app.ahms-hospital.com {
	# Everything → frontend (nginx). nginx serves the SPA, applies the
	# /index.html fallback, and proxies /api/* to the backend container.
	reverse_proxy frontend:80

	encode gzip
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
